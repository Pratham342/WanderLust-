<% layout("/layouts/boilerplate.ejs") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h2>Create new List</h2>
        <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title: </label>
                <input type="text" required name="listing[title]" id="title" class="form-control" placeholder="Enter Title">
                <div class="valid-feedback">Title Looks good.</div>
                <div class="invalid-feedback">Please Enter title.</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description: </label>
                <textarea type="text" required name="listing[description]" class="form-control" id="description" placeholder="Enter Description"></textarea>
                <div class="invalid-feedback">Please enter a short description.</div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload Image: </label>
                <input type="file" name="listing[image]" class="form-control" id="image" placeholder="Enter image URL/link" required>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price: </label>
                    <input required name="listing[price]" id="price" class="form-control" placeholder="1200">
                    <div class="invalid-feedback">Price should be vaild.</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country: </label>
                    <input type="text" required name="listing[country]" id="country" class="form-control" placeholder="India">
                    <div class="invalid-feedback">Country should be vaild.</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location: </label>
                <input type="text" required name="listing[location]" id="location" class="form-control" placeholder="Jaipur, Rajasthan">
                <div class="invalid-feedback">Location should be vaild.</div>
            </div>
            <button class="btn btn-dark add-btn mt-3">Add Listing</button><br><br>
        </form>
    </div>
</div>