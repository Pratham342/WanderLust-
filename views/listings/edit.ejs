<% layout("/layouts/boilerplate.ejs") %>
<div class="row mt-3">
    <div class="col-8 offset-2">   
        <h2>Edit List</h2>
        <form action="/listings/<%= listData._id %>?_method=put" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
            
            <div class="mb-3">
                <label class="form-label" for="title">Title: </label>
                <input type="text" required name="listing[title]" id="title" class="form-control" value="<%= listData.title %>">
                <div class="valid-feedback">Title Looks good.</div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="description">Description: </label>
                <textarea type="text" required name="listing[description]" id="description" class="form-control"><%= listData.description %></textarea>
                <div class="invalid-feedback">Please enter a short description.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Original Listing Image: </label><br>
                <img src="<%= originalImageUrl %>">
            </div>

            <div class="mb-3">
                <label class="form-label" for="image">Upload New Image: </label>
                <input type="file" name="listing[image]" id="image" class="form-control">
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label class="form-label" for="price">Price: </label>
                    <input type="number" required name="listing[price]" id="price" class="form-control" value="<%= listData.price %>">
                    <div class="invalid-feedback">Price should be vaild.</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label class="form-label" for="country">Country: </label>
                    <input type="text" required name="listing[country]" id="country" class="form-control" value="<%= listData.country %>">
                    <div class="invalid-feedback">Country should be vaild.</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="location">Location: </label>
                <input type="text" required name="listing[location]" id="location" class="form-control" value="<%= listData.location %>">
                <div class="invalid-feedback">Location should be vaild.</div>
            </div>

            <button class="btn btn-dark edit-btn mt-3">Update Listing</button><br><br>
        </form>
    </div>
</div>
    
